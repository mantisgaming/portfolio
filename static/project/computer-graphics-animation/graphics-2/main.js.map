export default "precision mediump float;\r\n\r\n// fragment attributes\r\nvarying vec3 v_camDir;\r\n\r\nuniform samplerCube u_CubeMap;\r\n\r\nvoid main() {\r\n    // use the camera direction for the fragment to pick the cubemap sample\r\n    vec3 color = textureCube(u_CubeMap, normalize(v_camDir)).rgb;\r\n    gl_FragColor = vec4(color, 1);\r\n}";